# These examples document environment variables. The app does not load .env files.
# Set them in PowerShell before launching; default paths need no configuration.
# Prototype defaults to data/prototype.json; renderer defaults to data/renderer.json.
# Use separate files when running both servers. Use off for temporary games.
SETTLERS_SAVE_FILE=data/my-games.json
PORT=3000
RENDERER_LAB_PORT=3002
